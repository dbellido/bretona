rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMember(hid) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members;
    }

    // Cada persona guarda a qué familia pertenece.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // La familia: solo sus miembros la ven y la cambian.
    match /households/{hid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.resource.data.members == [request.auth.uid];
      allow update: if
        (signedIn() && request.auth.uid in resource.data.members) ||
        // Unirse con el código: solo puedes añadirte a ti y tu nombre.
        (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.auth.uid in request.resource.data.members
          && request.resource.data.memberNames.diff(resource.data.memberNames).affectedKeys().hasOnly([request.auth.uid]));
      allow delete: if false;

      match /items/{itemId} {
        allow read, write: if isMember(hid);
      }
    }

    // Códigos de invitación: se pueden consultar uno a uno, nunca listar.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() &&
        request.auth.uid in getAfter(/databases/$(database)/documents/households/$(request.resource.data.hid)).data.members;
      allow update, delete: if false;
    }
  }
}
